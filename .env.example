# ===============================================================
# GIG-SENTINEL CONFIGURATION (.env)
# ===============================================================

# [Required] Telegram Bot Token (obtain from @BotFather)
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# [Optional] AI Provider API Key for Pitch Generation (e.g. Google Gemini / OpenAI)
# If omitted, Gig Sentinel will automatically use the built-in smart template engine
AI_API_KEY=your_gemini_or_llm_api_key_here

# [Optional] AI Model parameters
AI_MODEL=gemini-2.5-flash
AI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# [Optional] Feed & Sentinel Polling
HABR_RSS_URL=https://freelancehunt.com/projects.rss
POLL_INTERVAL_SECONDS=120
REQUEST_TIMEOUT=15.0

# [Optional] Storage & Logging
DB_PATH=data/gig_sentinel.db
LOG_LEVEL=INFO
